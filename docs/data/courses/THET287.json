{"id":"THET287","title":"Subversive Cultures and Performance","department":"Theatre","level":"Undergrad","credits":"3","description":"Every society has rebels - those who refuse to conform to the mainstream's rigid rules, aesthetics, and beliefs. From unruly skateboarders, punk rockers, bohemian poets, and radical theater performers, to national revolutionary movements and brick-throwing anarchists - such groups form niches that are defined by their exclusion from society. We will look at how their beliefs and actions fit into a particular historical context, and how their actions drive social change.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":60,"openSeats":22,"waitlist":0,"instructors":["Laurie Frederik"],"removed":false},{"term":"202301","sections":2,"seats":60,"openSeats":24,"waitlist":0,"instructors":["Van Tran Nguyen"],"removed":false},{"term":"202305","sections":1,"seats":20,"openSeats":20,"waitlist":0,"instructors":["Van Tran Nguyen"],"removed":false},{"term":"202308","sections":1,"seats":30,"openSeats":1,"waitlist":0,"instructors":["Van Tran Nguyen"],"removed":false},{"term":"202401","sections":2,"seats":60,"openSeats":30,"waitlist":0,"instructors":["Van Tran Nguyen"],"removed":false},{"term":"202408","sections":1,"seats":30,"openSeats":23,"waitlist":0,"instructors":["Lins Derry"],"removed":false},{"term":"202501","sections":1,"seats":30,"openSeats":14,"waitlist":0,"instructors":["Lins Derry"],"removed":false},{"term":"202508","sections":1,"seats":30,"openSeats":19,"waitlist":0,"instructors":["Lins Derry"],"removed":false},{"term":"202601","sections":1,"seats":25,"openSeats":15,"waitlist":0,"instructors":["Lins Derry"],"removed":false},{"term":"202701","sections":1,"seats":3,"openSeats":3,"waitlist":0,"instructors":["Patrick Saunders"],"removed":false}],"instructors":[{"name":"Lins Derry","terms":4,"slug":"danc-lins-derry"},{"name":"Van Tran Nguyen","terms":4,"slug"