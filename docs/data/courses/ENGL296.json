{"id":"ENGL296","title":"Reading and Writing Disability: Rights and Representation","department":"English","level":"Undergrad","credits":"3","description":"Locate and analyze disability in various settings, modes, and texts. Investigate the material and cultural effects of the language, stories, and myths of disability. Explore the many definitions and frameworks of disability: as dynamic lived experiences, as a political identity, as a rich culture, as socially constructed barriers, and as an oppressed minority group. Examine how disability is portrayed, controlled, stereotyped, and celebrated across social, medical, political, cultural, and personal networks.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201808","sections":1,"seats":20,"openSeats":6,"waitlist":0,"instructors":["Cheryl Spinner"],"removed":false},{"term":"201908","sections":1,"seats":20,"openSeats":3,"waitlist":0,"instructors":["Tamar Leroy"],"removed":false},{"term":"202008","sections":1,"seats":20,"openSeats":0,"waitlist":0,"instructors":["Konstantinos Pozoukidis"],"removed":false},{"term":"202108","sections":1,"seats":20,"openSeats":1,"waitlist":0,"instructors":["Elizabeth Catchmark"],"removed":false},{"term":"202208","sections":1,"seats":20,"openSeats":0,"waitlist":0,"instructors":["Alan Montroso"],"removed":false},{"term":"202308","sections":1,"seats":20,"openSeats":2,"waitlist":0,"instructors":["Alan Montroso"],"removed":false},{"term":"202408","sections":1,"seats":20,"openSeats":0,"waitlist":0,"instructors":["Alan Montroso"],"removed":false},{"term":"202508","sections":1,"seats":20,"openSeats":0,"waitlist":0,"instructors":["Alan Montroso"],"removed":false},{"term":"202608","sections":1,"seats":20,"openSeats":1,"waitlist":0,"instructors":["Alan Montroso"],"removed":false}],"instructors":[{"name":"Alan Montroso","terms":5,"slug":"engl-alan-montroso"},{"name":"Cheryl Spinner","terms":1,"slug":"engl-cheryl-spinner"},{"name":"Elizabeth C