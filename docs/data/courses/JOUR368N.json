{"id":"JOUR368N","title":"Topics in Broadcast and Electronic Media; Advanced Photojournalism","department":"Journalism","level":"Undergrad","credits":"3","description":"Prerequisite: JOUR370.\n\nThis course will provide a deeper dive into the storytelling medium of photojournalism. Students will learn the skills necessary to tell in-depth, long-term stories through the use of still photography. Topics of discussion will include the history of photojournalism, changing approaches to the photo story/photo essay overtime, how to approach a variety of potential subject matter and situations, finding long-term photo story projects and organizing images for a variety of digital and traditional formats.","gradingMethods":"Reg, P-F, Aud","noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"202008","sections":1,"seats":14,"openSeats":2,"waitlist":0,"instructors":["Timothy Jacobsen"],"removed":false},{"term":"202101","sections":1,"seats":13,"openSeats":0,"waitlist":0,"instructors":["Timothy Jacobsen"],"removed":false},{"term":"202108","sections":2,"seats":22,"openSeats":8,"waitlist":0,"instructors":["Timothy Jacobsen","Nicole Munchel"],"removed":false},{"term":"202201","sections":1,"seats":12,"openSeats":2,"waitlist":0,"instructors":["Timothy Jacobsen"],"removed":false},{"term":"202208","sections":2,"seats":22,"openSeats":13,"waitlist":0,"instructors":["Timothy Jacobsen","Nicole Munchel"],"removed":false},{"term":"202301","sections":1,"seats":12,"openSeats":6,"waitlist":0,"instructors":["Timothy Jacobsen"],"removed":false},{"term":"202308","sections":1,"seats":8,"openSeats":3,"waitlist":0,"instructors":["Timothy Jacobsen"],"removed":false},{"term":"202401","sections":1,"seats":12,"openSeats":6,"waitlist":0,"instructors":["Timothy Jacobsen"],"removed":false},{"term":"202408","sections":1,"seats":8,"openSeats":2,"waitlist":0,"instructors":["Timothy Jacobsen"],"removed":false}],"instructors":[{"name":"Timothy Jacobsen","terms":9,"slug":"jour-timoth