{"id":"ENEE459A","title":"Topics in Computer Engineering; CAD Tools","department":"Electrical & Computer Engineering","level":"Undergrad","credits":"1","description":"Minimum grade of C- in ENEE245.\n\nVerilog or VDHL hardware description languages (HDLs) and graphical printed ciruit design CAD packages are used to create a digital system implemented on a printed circuit-board. A practical design for hardware incorporating a processor and interface devices is to be created by the student. Simulation is used to explore practical issues of system performance and device resource constraints, and a printed-circuit board proof-of-concept will be produced by the student.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201808","sections":1,"seats":12,"openSeats":2,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"201908","sections":1,"seats":12,"openSeats":5,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202008","sections":1,"seats":12,"openSeats":0,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202108","sections":1,"seats":12,"openSeats":2,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202208","sections":1,"seats":12,"openSeats":1,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202308","sections":1,"seats":12,"openSeats":3,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202408","sections":1,"seats":12,"openSeats":1,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202508","sections":1,"seats":15,"openSeats":1,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202608","sections":1,"seats":15,"openSeats":0,"waitlist":0,"instructors":["William Hawkins"],"removed":false}],"instructors":[{"name":"William Hawkins","terms":9,"slug":"enee-william-hawkins"}]}