{"id":"JOUR368Y","title":"Topics in Broadcast and Electronic Media; Sports Producing","department":"Journalism","level":"Undergrad","credits":"3","description":"Prerequisite: JOUR262 or JOUR347; and JOUR360 or JOUR320.\n\nThis class will take an analytical look at sports TV and sports content by deconstructing shows. We will examine the producer's role in creating the look, feel and direction of shows and learn how to choose a lead story, how to \"tease\" effectively and the importance of identifying and telling good stories. We will watch live televised sporting events to better understand the techniques used by directors and producers. Students will get hands-on experience with BTN2GO and learn all aspects of live game production.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":12,"openSeats":3,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"201808","sections":1,"seats":12,"openSeats":0,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"201908","sections":1,"seats":12,"openSeats":1,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"202001","sections":1,"seats":12,"openSeats":1,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"202008","sections":1,"seats":12,"openSeats":0,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"202101","sections":1,"seats":12,"openSeats":0,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"202108","sections":1,"seats":12,"openSeats":1,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"202201","sections":1,"seats":12,"openSeats":3,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"202208","sections":1,"seats":8,"openSeats":2,"waitlist":0,"instructors":["Joseph Yasharoff"],"removed":false},{"term":"202301","sections":1,"seats":11,"openSeats":1,"waitlist":0,"instructors