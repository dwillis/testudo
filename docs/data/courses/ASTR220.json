{"id":"ASTR220","title":"Collisions in Space - The Threat of Asteroid Impacts","department":"Astronomy","level":"Undergrad","credits":"3","description":"Restriction: Must not be in the Astronomy major. Should we defend our planet against potential asteroid impacts? Collisions in Space will evaluate the threat of asteroid impacts with the Earth using knowledge of asteroid characteristics and orbits. The merits of possible defense plans will be discussed, as well as the budgetary and political concerns associated with implementing any such plan. Appropriate for non-science majors.","gradingMethods":"Reg, P-F, Aud","noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":2,"seats":60,"openSeats":1,"waitlist":0,"instructors":["Derek Richardson"],"removed":false},{"term":"201908","sections":2,"seats":60,"openSeats":0,"waitlist":0,"instructors":["Jessica Sunshine"],"removed":false},{"term":"202008","sections":2,"seats":60,"openSeats":0,"waitlist":0,"instructors":["Jessica Sunshine"],"removed":false},{"term":"202108","sections":2,"seats":60,"openSeats":1,"waitlist":0,"instructors":["Derek Richardson"],"removed":false},{"term":"202201","sections":2,"seats":60,"openSeats":2,"waitlist":0,"instructors":["Derek Richardson"],"removed":false},{"term":"202301","sections":2,"seats":60,"openSeats":0,"waitlist":0,"instructors":["Jessica Sunshine"],"removed":false},{"term":"202401","sections":2,"seats":60,"openSeats":2,"waitlist":0,"instructors":["Jessica Sunshine"],"removed":false},{"term":"202501","sections":2,"seats":60,"openSeats":0,"waitlist":0,"instructors":["Jessica Sunshine","Joseph DeMartini"],"removed":false}],"instructors":[{"name":"Jessica Sunshine","terms":5,"slug":"astr-jessica-sunshine"},{"name":"Derek Richardson","terms":3,"slug":"astr-derek-richardson"},{"name":"Joseph DeMartini","terms":1,"slug":"astr-joseph-demartini"}]}