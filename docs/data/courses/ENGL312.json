{"id":"ENGL312","title":"Romantic to Modern British Literature and Culture","department":"English","level":"Undergrad","credits":"3","description":"Explore 19th- and 20th-century British and Anglophone literary cultures, including Romanticism, Victorianism, and Modernism. We will read poetry, prose, and drama by authors such as Mary and Percy Shelley to Austen, Dickens, Eliot, Tagore, and Woolf. Learn about the history of empire and resistance, the industrial revolution, capitalism, communism, feminism, race, and new forms of literary and artistic creation.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":29,"openSeats":3,"waitlist":0,"instructors":["Heidi Scott"],"removed":false},{"term":"201908","sections":1,"seats":28,"openSeats":4,"waitlist":0,"instructors":["Orrin Wang"],"removed":false},{"term":"202008","sections":1,"seats":27,"openSeats":1,"waitlist":0,"instructors":["Brian Richardson"],"removed":false},{"term":"202101","sections":1,"seats":28,"openSeats":1,"waitlist":0,"instructors":["Brian Richardson"],"removed":false},{"term":"202108","sections":1,"seats":25,"openSeats":4,"waitlist":0,"instructors":["Jason Rudy"],"removed":false},{"term":"202201","sections":1,"seats":25,"openSeats":1,"waitlist":0,"instructors":["Orrin Wang"],"removed":false},{"term":"202208","sections":1,"seats":25,"openSeats":4,"waitlist":0,"instructors":["Orrin Wang"],"removed":false},{"term":"202408","sections":1,"seats":25,"openSeats":1,"waitlist":0,"instructors":["Brian Richardson"],"removed":false},{"term":"202508","sections":1,"seats":25,"openSeats":0,"waitlist":0,"instructors":["Brian Richardson"],"removed":false}],"instructors":[{"name":"Brian Richardson","terms":4,"slug":"engl-brian-richardson"},{"name":"Orrin Wang","terms":3,"slug":"engl-orrin-wang"},{"name":"Heidi Scott","terms":1,"slug":"engl-heidi-scott"},{"name":"Jason Rudy","terms":1,"slug":"engl-jason-rudy"}]}