{"id":"GEOL124","title":"Evolution of Life and Environment on Planet Earth","department":"Geology","level":"Undergrad","credits":"3","description":"An exploration of how life has shaped Earth's physical environments, both in the contemporary Earth and over the long course of Earth history. Topics range from evidence for the origin and diversification of life and its impact on Earth environments to the mind-set and methods of the scientists who interpret it, and what those methods tell us about future interactions between life and the environment, both on Earth and in the Solar System.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201808","sections":3,"seats":45,"openSeats":11,"waitlist":0,"instructors":["Alan Kaufman"],"removed":false},{"term":"201908","sections":3,"seats":60,"openSeats":13,"waitlist":0,"instructors":["James Farquhar"],"removed":false},{"term":"202008","sections":3,"seats":60,"openSeats":15,"waitlist":0,"instructors":["James Farquhar"],"removed":false},{"term":"202108","sections":3,"seats":60,"openSeats":24,"waitlist":0,"instructors":["James Farquhar"],"removed":false},{"term":"202208","sections":3,"seats":54,"openSeats":6,"waitlist":0,"instructors":["James Farquhar"],"removed":false},{"term":"202308","sections":3,"seats":61,"openSeats":12,"waitlist":0,"instructors":["James Farquhar"],"removed":false},{"term":"202408","sections":3,"seats":60,"openSeats":36,"waitlist":0,"instructors":["James Farquhar"],"removed":false},{"term":"202608","sections":3,"seats":60,"openSeats":49,"waitlist":0,"instructors":["Alan Kaufman"],"removed":false}],"instructors":[{"name":"James Farquhar","terms":6,"slug":"geol-james-farquhar"},{"name":"Alan Kaufman","terms":2,"slug":"geol-alan-kaufman"}]}