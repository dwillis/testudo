{"id":"BSST635","title":"Countering Violent Extremism: Policy and Practice","department":"Terrorism Studies","level":"Grad","credits":"3","description":"In recent years, the understanding of how and why individuals engage in violent extremism and terrorism has evolved and become more nuanced, as have the tools to mitigate these threats. A field of policy and practice called Countering Violent Extremism (CVE) has emerged that focuses on countering the pull of terrorist recruitment and influence by building resilience among populations vulnerable to radicalization.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201808","sections":1,"seats":30,"openSeats":21,"waitlist":0,"instructors":["Susan Szmania"],"removed":false},{"term":"201908","sections":1,"seats":30,"openSeats":19,"waitlist":0,"instructors":["Bryan Arva"],"removed":false},{"term":"202008","sections":1,"seats":30,"openSeats":22,"waitlist":0,"instructors":["Bryan Arva"],"removed":false},{"term":"202108","sections":1,"seats":30,"openSeats":17,"waitlist":0,"instructors":["Samuel Henkin"],"removed":false},{"term":"202208","sections":1,"seats":30,"openSeats":13,"waitlist":0,"instructors":["Samuel Henkin"],"removed":false},{"term":"202308","sections":1,"seats":30,"openSeats":18,"waitlist":0,"instructors":["Samuel Henkin"],"removed":false},{"term":"202408","sections":1,"seats":30,"openSeats":16,"waitlist":0,"instructors":["Sandra Scham"],"removed":false},{"term":"202508","sections":1,"seats":30,"openSeats":15,"waitlist":0,"instructors":["Michael Jensen"],"removed":false},{"term":"202608","sections":1,"seats":30,"openSeats":22,"waitlist":0,"instructors":["Amy Pate"],"removed":false}],"instructors":[{"name":"Samuel Henkin","terms":3,"slug":"bsst-samuel-henkin"},{"name":"Bryan Arva","terms":2,"slug":"bsst-bryan-arva"},{"name":"Amy Pate","terms":1,"slug":"bsst-amy-pate"},{"name":"Michael Jensen","terms":1,"slug":"bsst-michael-jensen"},{"name":"Sandra Scham","ter