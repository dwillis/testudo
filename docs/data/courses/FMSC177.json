{"id":"FMSC177","title":"BE WELL: Building Emotional Wellness through ExperientiaL Learning","department":"Family Science","level":"Undergrad","credits":"1","description":"Students on UMD campus experience new challenges to their mental health and well-being every semester, and there are limited resources to help students manage their own health or to support their peers. This experiential skill development workshop course is designed to assist students in developing their knowledge in ways to recognize, manage, and cope with symptoms of stress, anxiety, and depression. There is a focus on coping with pandemic-related and course-related concerns, relationship issues, and a range of other student concerns.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"202301","sections":2,"seats":60,"openSeats":2,"waitlist":0,"instructors":["Amy Morgan","Coda Gerber"],"removed":false},{"term":"202305","sections":1,"seats":15,"openSeats":9,"waitlist":0,"instructors":["Coda Gerber"],"removed":false},{"term":"202308","sections":2,"seats":60,"openSeats":21,"waitlist":0,"instructors":["Coda Gerber","Amy Morgan"],"removed":false},{"term":"202401","sections":2,"seats":60,"openSeats":2,"waitlist":0,"instructors":["Coda Gerber"],"removed":false},{"term":"202405","sections":1,"seats":15,"openSeats":15,"waitlist":0,"instructors":["Adrian Cortez"],"removed":false},{"term":"202408","sections":2,"seats":60,"openSeats":16,"waitlist":0,"instructors":["Adrian Cortez","Amy Morgan"],"removed":false},{"term":"202501","sections":2,"seats":60,"openSeats":2,"waitlist":0,"instructors":["Adrian Cortez","Amy Morgan"],"removed":false},{"term":"202508","sections":2,"seats":60,"openSeats":49,"waitlist":0,"instructors":["Maria Graviet","Amy Morgan"],"removed":false},{"term":"202601","sections":2,"seats":60,"openSeats":40,"waitlist":0,"instructors":["Maria Graviet","Amy Morgan"],"removed":false},{"term":"202608","sections":2,"seats":60,"openSeats":30,"wa