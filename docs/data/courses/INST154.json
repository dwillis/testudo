{"id":"INST154","title":"Apollo at 50","department":"Information Studies","level":"Undergrad","credits":"3","description":"Examines Apollo mission, one of the greatest engineering accomplishments of all time, in which Neil Armstrong walked on the moon. Since the mission, people have asked: if we can land on the moon, why can't we eliminate poverty? Why can't we cure cancer? Why can't we prevent global warming? Asks what were the social, political, financial, scientific, engineering, operational, and human aspects of the Apollo program that came together to make the moon landings possible?","gradingMethods":"Reg, P-F, Aud","noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201908","sections":1,"seats":78,"openSeats":3,"waitlist":0,"instructors":["Douglas Oard"],"removed":false},{"term":"202001","sections":1,"seats":78,"openSeats":7,"waitlist":0,"instructors":["Douglas Oard"],"removed":false},{"term":"202008","sections":1,"seats":150,"openSeats":73,"waitlist":0,"instructors":["Douglas Oard"],"removed":false},{"term":"202101","sections":1,"seats":78,"openSeats":0,"waitlist":0,"instructors":["Douglas Oard"],"removed":false},{"term":"202108","sections":1,"seats":78,"openSeats":0,"waitlist":0,"instructors":["Douglas Oard"],"removed":false},{"term":"202201","sections":1,"seats":78,"openSeats":0,"waitlist":0,"instructors":["Dennis Frezzo"],"removed":false},{"term":"202208","sections":1,"seats":78,"openSeats":0,"waitlist":0,"instructors":["Douglas Oard"],"removed":false},{"term":"202301","sections":1,"seats":92,"openSeats":0,"waitlist":0,"instructors":["Dennis Frezzo"],"removed":false},{"term":"202308","sections":1,"seats":75,"openSeats":0,"waitlist":0,"instructors":["Dennis Frezzo"],"removed":false},{"term":"202401","sections":1,"seats":92,"openSeats":1,"waitlist":0,"instructors":["Dennis Frezzo"],"removed":false},{"term":"202501","sections":1,"seats":92,"openSeats":0,"waitlist":0,"instructors":["Douglas Oard"],"removed":false}],"instructors