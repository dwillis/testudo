{"id":"CMLT235","title":"Black Diaspora Literature and Culture","department":"Comparative Literature","level":"Undergrad","credits":"3","description":"Examination of key works by writers of the African Diaspora. Relationship among black people across multiple geographic spaces; Africa, the Caribbean, the United States, Europe, Latin America, and Asia. Specific historical, cultural, and literary contexts; themes such as gender, sexuality, migration, slavery, freedom, and equality. Readings may include literary texts (fiction, poetry, drama), music and film. All readings in English, but drawn from multiple languages of the black diaspora, including English, Spanish, French and Portuguese.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":30,"openSeats":14,"waitlist":0,"instructors":["Emily Perez"],"removed":false},{"term":"201808","sections":1,"seats":30,"openSeats":9,"waitlist":0,"instructors":["Steve Beaulieu"],"removed":false},{"term":"201908","sections":1,"seats":30,"openSeats":10,"waitlist":0,"instructors":["Alexandria Nunn"],"removed":false},{"term":"202001","sections":1,"seats":30,"openSeats":24,"waitlist":0,"instructors":["Steve Beaulieu"],"removed":false},{"term":"202008","sections":1,"seats":30,"openSeats":7,"waitlist":0,"instructors":["Nancy Vera"],"removed":false},{"term":"202108","sections":1,"seats":30,"openSeats":3,"waitlist":0,"instructors":["Andrea Knowles"],"removed":false},{"term":"202201","sections":1,"seats":30,"openSeats":9,"waitlist":0,"instructors":["Fredrick Cherry Jr"],"removed":false},{"term":"202208","sections":1,"seats":30,"openSeats":1,"waitlist":0,"instructors":["Laura Williams"],"removed":false},{"term":"202301","sections":1,"seats":30,"openSeats":6,"waitlist":0,"instructors":["Anthony Batts"],"removed":false},{"term":"202308","sections":1,"seats":30,"openSeats":3,"waitlist":0,"instructors":["Chauncey Dennie"],"removed":false},{"term":"202401","section