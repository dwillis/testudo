{"id":"ANSC688J","title":"Special Topics; Zoonotic Diseases and Control","department":"Animal Science","level":"Grad","credits":"3","description":"Prerequisites: BSCI223; recommended NFSC430; or permission of instructor.\n\nLectures will take a global perspective of foodborne diseases common to animals and man, specifically those caused by farm animal-originated human pathogens (zoonoses) and their control. A selection of important zoonoses and food safety issues will be specifically covered with an emphasis on the principles of zoonotic disease transmission and control, risk factors to humans, and surveillance mehtods.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":6,"openSeats":5,"waitlist":0,"instructors":["Debabrata Biswas"],"removed":false},{"term":"202001","sections":1,"seats":6,"openSeats":2,"waitlist":0,"instructors":["Debabrata Biswas"],"removed":false},{"term":"202101","sections":1,"seats":6,"openSeats":1,"waitlist":0,"instructors":["Debabrata Biswas"],"removed":false},{"term":"202201","sections":1,"seats":6,"openSeats":3,"waitlist":0,"instructors":["Debabrata Biswas"],"removed":false},{"term":"202301","sections":1,"seats":6,"openSeats":5,"waitlist":0,"instructors":["Debabrata Biswas"],"removed":false},{"term":"202401","sections":1,"seats":6,"openSeats":5,"waitlist":0,"instructors":["Andrew Broadbent","Debabrata Biswas"],"removed":false},{"term":"202501","sections":1,"seats":6,"openSeats":4,"waitlist":0,"instructors":["Andrew Broadbent","Debabrata Biswas"],"removed":false},{"term":"202601","sections":1,"seats":6,"openSeats":6,"waitlist":0,"instructors":["Andrew Broadbent","Debabrata Biswas"],"removed":false}],"instructors":[{"name":"Debabrata Biswas","terms":8,"slug":"ansc-debabrata-biswas"},{"name":"Andrew Broadbent","terms":3,"slug":"ansc-andrew-broadbent"}]}