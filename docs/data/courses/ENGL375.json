{"id":"ENGL375","title":"J.R.R. Tolkien: Middle-earth and Beyond","department":"English","level":"Undergrad","credits":"3","description":"An in-depth look at major themes and ideas spanning Tolkien's well-known and lesser-known works across a variety of genres and styles. We will study \"The Hobbit\" and \"The Lord of the Rings\" in connection with Tolkien's back-story mythology expressed in \"The Silmarillion.\" We will also consider film adaptations and other popular fantasy influenced by Tolkien. And we will explore lesser-known works such as \"Farmer Giles of Ham,\" and Tolkien's essays on fairy stories and on \"Beowulf.","gradingMethods":"Reg, P-F, Aud","noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201805","sections":1,"seats":20,"openSeats":0,"waitlist":0,"instructors":["Christopher Crane"],"removed":false},{"term":"201908","sections":1,"seats":28,"openSeats":1,"waitlist":0,"instructors":["Christopher Crane"],"removed":false},{"term":"202005","sections":1,"seats":25,"openSeats":4,"waitlist":0,"instructors":["Vessela Valiavitcharska"],"removed":false},{"term":"202105","sections":1,"seats":25,"openSeats":25,"waitlist":0,"instructors":["Vessela Valiavitcharska"],"removed":false},{"term":"202201","sections":1,"seats":25,"openSeats":2,"waitlist":0,"instructors":["Vessela Valiavitcharska"],"removed":false},{"term":"202205","sections":1,"seats":25,"openSeats":12,"waitlist":0,"instructors":["Vessela Valiavitcharska"],"removed":false},{"term":"202301","sections":1,"seats":27,"openSeats":2,"waitlist":0,"instructors":["Thomas Moser"],"removed":false},{"term":"202305","sections":1,"seats":25,"openSeats":9,"waitlist":0,"instructors":["Vessela Valiavitcharska"],"removed":false},{"term":"202308","sections":1,"seats":25,"openSeats":0,"waitlist":0,"instructors":["Peter Grybauskas"],"removed":false},{"term":"202405","sections":1,"seats":25,"openSeats":13,"waitlist":0,"instructors":["Vessela Valiavitcharska"],"removed":false},{"term":"202408