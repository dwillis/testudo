{"id":"MATH003","title":"Developmental Mathematics","department":"Mathematics","level":"Undergrad","credits":"3","description":"A review of Intermediate High School Algebra intended for students preparing for one of the credit bearing Fundamental Studies Math Courses. It is taught in special computer labs using a self-paced computer program. The curriculum will be geared toward the student's level of algebra skills and eventual goals. There is a special fee for the course that may be applied in addition to the regular tuition charge. Students should refer to the schedule of classes for details on fees as they apply to a particular semester. The course does not carry any credit toward any degree at the University. The course is repeatable. Topics will be chosen from exponents, polynomials, linear equations, quadratic equations as well as polynomial, rational, exponential and logarithm functions and elementary probability or statistics, depending on the student.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":4,"seats":80,"openSeats":29,"waitlist":0,"instructors":["Colleen Terpos"],"removed":false},{"term":"201808","sections":9,"seats":242,"openSeats":72,"waitlist":0,"instructors":["Barbara Michelato","Colleen Terpos","Jack Baker"],"removed":false},{"term":"201908","sections":8,"seats":217,"openSeats":56,"waitlist":0,"instructors":["Matthew Wilson","Charles Daly","Colleen Terpos","Jack Baker"],"removed":false},{"term":"202001","sections":4,"seats":80,"openSeats":19,"waitlist":0,"instructors":["Colleen Terpos"],"removed":false},{"term":"202008","sections":8,"seats":212,"openSeats":74,"waitlist":0,"instructors":["Matt Wilson","Jayna Resman","Colleen Terpos","Carlotta Amaduzzi"],"removed":false},{"term":"202101","sections":4,"seats":80,"openSeats":43,"waitlist":0,"instructors":["Colleen Terpos"],"removed":false},{"term":"202108","sections":8,"seats":260,"openSeats":76,"waitlist":0,"instructors"