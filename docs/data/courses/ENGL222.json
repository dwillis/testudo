{"id":"ENGL222","title":"American Literature(s)","department":"English","level":"Undergrad","credits":"3","description":"Explore American literary traditions in a variety of poetic and narrative forms and in diverse historical contexts, ranging from colonization to the Civil Rights Movement and beyond. Genres examined in this course might include lyric poems, travel narratives, gothic short fiction, slave narratives, and science fiction. Emphasis on developing skills of literary interpretation and critical writing, while attending to the place of race, class, gender, and sexuality in American literary culture. Authors may include Phillis Wheatley, Herman Melville, Walt Whitman, Emily Dickinson, Frederick Douglass, Gertrude Stein, F. Scott Fitzgerald, James Baldwin, and Toni Morrison, among others.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":30,"openSeats":3,"waitlist":0,"instructors":["William Gonch"],"removed":false},{"term":"201808","sections":1,"seats":30,"openSeats":15,"waitlist":0,"instructors":["Sarah Humud"],"removed":false},{"term":"201908","sections":1,"seats":30,"openSeats":3,"waitlist":0,"instructors":["William Gonch"],"removed":false},{"term":"202001","sections":1,"seats":30,"openSeats":9,"waitlist":0,"instructors":["Jeannette Schollaert"],"removed":false},{"term":"202008","sections":1,"seats":30,"openSeats":14,"waitlist":0,"instructors":["Kerishma Panigrahi"],"removed":false},{"term":"202101","sections":1,"seats":30,"openSeats":20,"waitlist":0,"instructors":["Alexandria Nunn"],"removed":false},{"term":"202108","sections":1,"seats":30,"openSeats":2,"waitlist":0,"instructors":["Annemarie Ewing"],"removed":false},{"term":"202201","sections":1,"seats":30,"openSeats":7,"waitlist":0,"instructors":["Gerard Holmes"],"removed":false},{"term":"202208","sections":1,"seats":30,"openSeats":2,"waitlist":0,"instructors":["Diana Proenza"],"removed":false},{"term":"202301","secti