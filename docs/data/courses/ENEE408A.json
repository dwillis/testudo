{"id":"ENEE408A","title":"Capstone Design Project:Microprocessor-Based Design","department":"Electrical & Computer Engineering","level":"Undergrad","credits":"3","description":"Prerequisite: Minimum grade of C- in ENEE350.\n\nThis course provides a team-based experience in the design and implementation of a microprocessor-based system to solve a real-world problem. A product specification or client requirement forms the basis for the student teams development of an initial technical design specification. The team then divides into smaller groups for the parallel development of hardware and software subsystems of the product device. Upon completion and test of the various subsystems, software and hardware components are integrated into the system prototype and the system is tested and documented.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":12,"openSeats":0,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"201808","sections":1,"seats":12,"openSeats":6,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"201908","sections":1,"seats":12,"openSeats":1,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202001","sections":1,"seats":17,"openSeats":0,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202008","sections":1,"seats":12,"openSeats":0,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202101","sections":1,"seats":17,"openSeats":0,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202108","sections":1,"seats":12,"openSeats":3,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202201","sections":1,"seats":18,"openSeats":1,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202208","sections":1,"seats":12,"openSeats":0,"waitlist":0,"instructors":["William Hawkins"],"removed":false},{"term":"202301","sectio