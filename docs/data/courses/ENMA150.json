{"id":"ENMA150","title":"Materials of Civilization","department":"Engineering, Materials","level":null,"credits":"3","description":"The discovery of new materials has shaped history and built civilizations. The utilization, properties and production techniques of materials from the Bronze Age up through modern times and into the future will be traced. These materials are explained by considering their atomic structure, the binding forces between atoms and their arrangement, and how controlling the structure controls the materials properties.","gradingMethods":"Reg, P-F, Aud","noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201808","sections":2,"seats":80,"openSeats":2,"waitlist":0,"instructors":["Robert Briber"],"removed":false},{"term":"201908","sections":2,"seats":80,"openSeats":11,"waitlist":0,"instructors":["Robert Briber"],"removed":false},{"term":"202008","sections":2,"seats":80,"openSeats":11,"waitlist":0,"instructors":["Timothy Foecke"],"removed":false},{"term":"202108","sections":2,"seats":80,"openSeats":31,"waitlist":0,"instructors":["Timothy Foecke"],"removed":false},{"term":"202208","sections":2,"seats":45,"openSeats":2,"waitlist":0,"instructors":["Robert Briber"],"removed":false},{"term":"202308","sections":2,"seats":45,"openSeats":2,"waitlist":0,"instructors":["Robert Briber"],"removed":false},{"term":"202408","sections":2,"seats":45,"openSeats":45,"waitlist":0,"instructors":["Robert Briber"],"removed":false}],"instructors":[{"name":"Robert Briber","terms":5,"slug":"enma-robert-briber"},{"name":"Timothy Foecke","terms":2,"slug":"enma-timothy-foecke"}]}