{"id":"INST710","title":"User Experience Research Methods","department":"Information Studies","level":"Grad","credits":"3","description":"Students will learn to conduct user research in industry and to provide foundational knowledge needed for academic research. It examines the theoretical and epistemological differences between research paradigms and provides an overview of qualitative, quantitative and mixed-method approaches. It overviews user-centered design (UCD) methods, and uses Contextual Inquiry/Contextual Design as the backbone for a research project, incorporating related formative UCD methods and techniques. It is a project-based course, where students conduct a semester-long project to prepare them for the HCIM Capstone as well as other types of formative user research.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201908","sections":1,"seats":35,"openSeats":2,"waitlist":0,"instructors":["Wayne Lutters"],"removed":false},{"term":"202008","sections":1,"seats":40,"openSeats":1,"waitlist":0,"instructors":["Wayne Lutters"],"removed":false},{"term":"202108","sections":1,"seats":40,"openSeats":0,"waitlist":0,"instructors":["Wayne Lutters"],"removed":false},{"term":"202201","sections":1,"seats":30,"openSeats":4,"waitlist":0,"instructors":["Wayne Lutters"],"removed":false},{"term":"202208","sections":1,"seats":40,"openSeats":3,"waitlist":0,"instructors":["Heera Lee"],"removed":false},{"term":"202301","sections":1,"seats":40,"openSeats":21,"waitlist":0,"instructors":["Heera Lee"],"removed":false},{"term":"202308","sections":1,"seats":40,"openSeats":3,"waitlist":0,"instructors":["Heera Lee"],"removed":false},{"term":"202401","sections":1,"seats":40,"openSeats":27,"waitlist":0,"instructors":["Stephanie Valencia Valencia"],"removed":false},{"term":"202408","sections":1,"seats":40,"openSeats":7,"waitlist":0,"instructors":["Tamara Clegg"],"removed":false},{"term":"202501","sections":1,"seats":40,"openSeats"