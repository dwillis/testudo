{"id":"ENAE788V","title":"Selected Topics in Aerospace Engineering; Unsteady Flows","department":"Engineering, Aerospace","level":"Grad","credits":"3","description":"Prerequisites: Background in Fluid Mechanics or Aerodynamics Restrictions: Permission from AE Department\n\nThis course will provide an overview of classical modeling techniques for unsteady flows, focusing on inviscid, incompressible methods. Viscous effects and higher fidelity modeling will also be discussed. Themain emphasis will be on the solutions of unsteady aerodynamics, and additional unsteady flow phenomena will be explored through a final project.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":5,"seats":35,"openSeats":21,"waitlist":0,"instructors":["Michael Otte"],"removed":false},{"term":"202001","sections":4,"seats":30,"openSeats":14,"waitlist":0,"instructors":["Michael Otte"],"removed":false},{"term":"202101","sections":1,"seats":20,"openSeats":4,"waitlist":0,"instructors":["Michael Otte"],"removed":false},{"term":"202201","sections":1,"seats":18,"openSeats":2,"waitlist":0,"instructors":["Michael Otte"],"removed":false},{"term":"202301","sections":1,"seats":18,"openSeats":7,"waitlist":0,"instructors":["Michael Otte"],"removed":false},{"term":"202401","sections":1,"seats":18,"openSeats":12,"waitlist":0,"instructors":["Michael Otte"],"removed":false},{"term":"202501","sections":1,"seats":18,"openSeats":8,"waitlist":0,"instructors":["Michael Otte"],"removed":false},{"term":"202701","sections":2,"seats":25,"openSeats":25,"waitlist":0,"instructors":["Cecilia Huertas Cerdeira"],"removed":false}],"instructors":[{"name":"Michael Otte","terms":7,"slug":"enae-michael-otte"},{"name":"Cecilia Huertas Cerdeira","terms":1,"slug":"enme-cecilia-huertas-cerdeira"}]}