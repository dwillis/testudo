{"id":"PLCY213","title":"Foundations of Nonprofit Leadership and Social Innovation","department":"Public Policy","level":"Undergrad","credits":"3","description":"Through discussions of contemporary trends, challenges and issues, this course provides an introduction to the nonprofit and NGO sectors, social innovation, and the leadership and management skills required to achieve social impact. The course will explore the history, theories, and roles of philanthropy, the nonprofit sector, and social innovation in societies and cultures. Students will be able to demonstrate an understanding of the process and principles of social entrepreneurship and social innovation. Additionally, the course will introduce students to topics in leadership, social innovation, resource development, community mobilization through networks, the role of policy-making in creating change, project management, and overall strategies for achieving social impact. The course will include mini hands-on learning experiences that allow them to apply key learning outcomes.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":45,"openSeats":2,"waitlist":0,"instructors":["Robert Grimm"],"removed":false},{"term":"201908","sections":2,"seats":80,"openSeats":18,"waitlist":0,"instructors":["Claire Dunning","Alexander Counts"],"removed":false},{"term":"202001","sections":2,"seats":70,"openSeats":0,"waitlist":0,"instructors":["Claire Dunning","Alexander Counts"],"removed":false},{"term":"202008","sections":2,"seats":80,"openSeats":9,"waitlist":0,"instructors":["Robert Grimm","Alexander Counts"],"removed":false},{"term":"202101","sections":2,"seats":80,"openSeats":1,"waitlist":0,"instructors":["Claire Dunning","Alexander Counts"],"removed":false},{"term":"202108","sections":2,"seats":80,"openSeats":1,"waitlist":0,"instructors":["Alexander Counts","Claire Dunning"],"removed":false},{"term":"202201","sections":2,"seats":80,"openS