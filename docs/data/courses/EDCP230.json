{"id":"EDCP230","title":"The Science and Practice of Happiness and Psychological Well-Being","department":"Education Counseling and Personnel Services","level":"Undergrad","credits":"3","description":"An introduction to theory and research on positive psychology, subjective well-being, and the psychology of happiness. This will include examination of hedonic and eudaimonic models of well-being and sociocultural understandings of happiness, together with how it relates to health, relationships, money, religion, work, and social media. Students will also explore common misconceptions and myths about happiness and well-being and will engage in a variety of activities designed to deepen their understanding of happiness in their own lives and broader societal trends related to well-being.","gradingMethods":null,"noLongerOffered":true,"removedTerm":"202608","removedDetected":"2026-08-17T20:22:45.997928Z","terms":[{"term":"202108","sections":1,"seats":20,"openSeats":2,"waitlist":0,"instructors":["Emily Cygrymus"],"removed":false},{"term":"202201","sections":2,"seats":36,"openSeats":0,"waitlist":0,"instructors":["Shereen Ashai","Emily Cygrymus"],"removed":false},{"term":"202205","sections":1,"seats":15,"openSeats":8,"waitlist":0,"instructors":["Shihong Lin","Amber Pasha","Hailey Fleece"],"removed":false},{"term":"202208","sections":3,"seats":60,"openSeats":0,"waitlist":0,"instructors":["Hailey Fleece","Shihong Lin","Amber Pasha"],"removed":false},{"term":"202301","sections":3,"seats":54,"openSeats":0,"waitlist":0,"instructors":["Shihong Lin","Hailey Fleece","Amber Pasha"],"removed":false},{"term":"202305","sections":1,"seats":25,"openSeats":22,"waitlist":0,"instructors":["Ilcia Hernandez","Stephanie Cerrato"],"removed":false},{"term":"202308","sections":6,"seats":118,"openSeats":0,"waitlist":0,"instructors":["Stephanie Cerrato","Anjali Sheth","Daniel Moore","Rabia Brown","Manuel Teran Hernandez","Amber Pasha"],"removed":false},{"term":"202401","sections":6,"seats":108,"open