{"id":"PLCY302","title":"Examining Pluralism in Public Policy","department":"Public Policy","level":"Undergrad","credits":"3","description":"Understanding pluralism and how groups and individuals coexist in society is an essential part of the public policy process. This course will examine the ways in which the diverse experiences of race, gender, ethnicity, class, orientation, identity, and religion impact the understanding of and equitable delivery of public policy. The examination of how identity development shapes our understanding of society and influences the decision-making process is central to students' shaping policy that is truly for the people. This course will equip students with the skills needed to analyze pluralism and draw conclusions about the application of various theories to public policy issues.","gradingMethods":null,"noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":1,"seats":40,"openSeats":0,"waitlist":0,"instructors":["Nina Harris"],"removed":false},{"term":"201808","sections":1,"seats":27,"openSeats":15,"waitlist":0,"instructors":["Eric Luedtke"],"removed":false},{"term":"201908","sections":2,"seats":62,"openSeats":11,"waitlist":0,"instructors":["Eric Luedtke","Alana Hackshaw"],"removed":false},{"term":"202001","sections":3,"seats":120,"openSeats":5,"waitlist":0,"instructors":["Nina Harris","Alana Hackshaw","Ricco Hall"],"removed":false},{"term":"202008","sections":3,"seats":95,"openSeats":3,"waitlist":0,"instructors":["Eric Luedtke","Alana Hackshaw","Chloe Schwenke"],"removed":false},{"term":"202101","sections":2,"seats":125,"openSeats":1,"waitlist":0,"instructors":["Nina Harris","Ricco Hall"],"removed":false},{"term":"202108","sections":4,"seats":145,"openSeats":19,"waitlist":0,"instructors":["Nina Harris","Ricco Hall","Erica Smith","Chloe Schwenke"],"removed":false},{"term":"202201","sections":4,"seats":180,"openSeats":24,"waitlist":0,"instructors":["Toby Egan","PATRINA CLARK","Alana H