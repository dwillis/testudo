{"id":"ENAE646","title":"Advanced Dynamics of Aerospace Systems","department":"Engineering, Aerospace","level":"Grad","credits":"3","description":"Prerequisite: ENAE301.\nCredit only granted for: ENAE788G or ENAE646.\nFormerly: ENAE788G. Introduces the principles and methods for formulating and analyzing mathematical models of aerospace systems using Newtonian, Lagrangian, and Hamiltonian formulations of particle and rigid body dynamics. Additional topics include applied dynamical systems, geometric mechanics, and symmetry and reduction.","gradingMethods":"Reg, Aud, S-F","noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":5,"seats":38,"openSeats":23,"waitlist":0,"instructors":["Olivier Bauchau"],"removed":false},{"term":"202001","sections":1,"seats":18,"openSeats":12,"waitlist":0,"instructors":["Olivier Bauchau"],"removed":false},{"term":"202101","sections":1,"seats":18,"openSeats":4,"waitlist":0,"instructors":["Derek Paley"],"removed":false},{"term":"202201","sections":1,"seats":18,"openSeats":18,"waitlist":0,"instructors":["Olivier Bauchau"],"removed":false},{"term":"202301","sections":1,"seats":18,"openSeats":6,"waitlist":0,"instructors":["Derek Paley"],"removed":false},{"term":"202401","sections":1,"seats":18,"openSeats":18,"waitlist":0,"instructors":["Derek Paley"],"removed":false},{"term":"202501","sections":1,"seats":16,"openSeats":2,"waitlist":0,"instructors":["Kleio Baxevani","Derek Paley"],"removed":false}],"instructors":[{"name":"Derek Paley","terms":4,"slug":"enae-derek-paley"},{"name":"Olivier Bauchau","terms":3,"slug":"enae-olivier-bauchau"},{"name":"Kleio Baxevani","terms":1,"slug":"enae-kleio-baxevani"}]}