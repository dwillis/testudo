{"id":"GEMS104","title":"Topics in Science, Technology and Society (STS)","department":"Gemstone","level":"Undergrad","credits":"3","description":"Prerequisite: GEMS100.\nRestriction: Must be in the Gemstone program. An examination of how cultural, economic, political and social forces shape scientific and technological systems and, conversely, how scientific and technological systems have affected the culture, economies, organization and politics of societies. Students in the course will form small teams to carry out semester-long research on socio/technical topics related to the course theme chosen for that specific semester.","gradingMethods":"Reg, P-F, Aud","noLongerOffered":false,"removedTerm":null,"removedDetected":null,"terms":[{"term":"201801","sections":13,"seats":150,"openSeats":7,"waitlist":0,"instructors":["Frank Coale","Leah Kreimer Tobin","Kristan Skendall"],"removed":false},{"term":"202001","sections":12,"seats":111,"openSeats":7,"waitlist":0,"instructors":["Kristan Skendall"],"removed":false},{"term":"202101","sections":13,"seats":136,"openSeats":9,"waitlist":0,"instructors":["Leah Kreimer Tobin","Kristan Skendall"],"removed":false},{"term":"202201","sections":15,"seats":180,"openSeats":32,"waitlist":0,"instructors":["David Lovell"],"removed":false},{"term":"202301","sections":14,"seats":182,"openSeats":33,"waitlist":0,"instructors":["David Lovell"],"removed":false},{"term":"202401","sections":13,"seats":169,"openSeats":44,"waitlist":0,"instructors":["Allison Lansverk"],"removed":false},{"term":"202501","sections":11,"seats":121,"openSeats":10,"waitlist":0,"instructors":["Allison Lansverk"],"removed":false}],"instructors":[{"name":"Kristan Skendall","terms":3,"slug":"gems-kristan-skendall"},{"name":"Allison Lansverk","terms":2,"slug":"gems-allison-lansverk"},{"name":"David Lovell","terms":2,"slug":"gems-david-lovell"},{"name":"Leah Kreimer Tobin","terms":2,"slug":"gems-leah-kreimer-tobin"},{"name":"Frank Coale","terms":1,"slug":"enst-frank-coale"}]}